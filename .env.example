# Copy to .env (never committed) and fill in. Read by src/agent.py.

# Folder of your AI4Science clone: Goose binary (.tools/goose) and course instructions
AI4SCIENCE_HOME=~/AI4Science

# Local model server (OpenAI-compatible). Default: vLLM serving Qwen3-Coder-30B-A3B FP8:
#   vllm serve Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8 --served-model-name qwen3-coder-30b \
#     --max-model-len 65536 --gpu-memory-utilization 0.92 --enable-auto-tool-choice --tool-call-parser qwen3_coder
# Ollama instead: LOCAL_URL=http://localhost:11434 and LOCAL_MODEL=qwen3-coder:30b
LOCAL_URL=http://localhost:8000
LOCAL_MODEL=qwen3-coder-30b
LOCAL_CONTEXT=65536
# LOCAL_API_KEY=            # only if you started vLLM with --api-key

# DeepSeek API (https://platform.deepseek.com); check current model names at
# https://api-docs.deepseek.com before running
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
